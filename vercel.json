{
  "redirects": [
    {
      "source": "/brand-experience.html",
      "destination": "/cases.html",
      "permanent": false
    },
    {
      "source": "/services.html",
      "destination": "/solutions.html",
      "permanent": true
    },
    {
      "source": "/visual.html",
      "destination": "/solutions-design-proposal.html",
      "permanent": true
    },
    {
      "source": "/tech.html",
      "destination": "/solutions-enterprise-digital.html",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/cases-3d.html",
      "permanent": true
    },
    {
      "source": "/process.html",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/insights.html",
      "destination": "/solutions.html",
      "permanent": true
    },
    {
      "source": "/service-3d-modeling-rendering.html",
      "destination": "/solutions-design-proposal.html",
      "permanent": true
    },
    {
      "source": "/service-custom-website-development.html",
      "destination": "/solutions-enterprise-digital.html",
      "permanent": true
    },
    {
      "source": "/article-3d-rendering-cost-taiwan.html",
      "destination": "/solutions-design-proposal.html",
      "permanent": true
    },
    {
      "source": "/article-custom-website-development-cost.html",
      "destination": "/solutions-enterprise-digital.html",
      "permanent": true
    },
    {
      "source": "/case-study-enterprise-site-revamp.html",
      "destination": "/cases-system.html",
      "permanent": true
    },
    {
      "source": "/wayto1/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://wayto.com.tw/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.kinghouse3d.com"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "https://wayto.com.tw/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "kinghouse3d.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.jpeg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
